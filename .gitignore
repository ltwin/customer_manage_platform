# 凭证红线：.env 永不入 git（CLAUDE.md 硬规则 4）
.env

# python
__pycache__/

node_modules/
frontend/dist/
backend/bin/
# 杂散 go build -o server 产物（构建输出统一进 backend/bin/，见 Makefile）
/backend/server
/backend/creative-worker
backend/internal/platform/webui/dist/*
!backend/internal/platform/webui/dist/.gitkeep

# Claude Code 执行 worktree
.claude/
.zcode/
.worktrees/

.DS_Store

var/

# AI Agents
.reasonix/
.workflow/
.agents/
.cursor/

# >>> lti managed ignore rules
# Versioned workflow artifacts; machine state stays local.
!/.lti/
!/.lti/**/
!/.lti/**/*.md
!/.lti/**/*.yaml
!/.lti/**/*.yml
!/.lti/features/**/meta.json
!/.lti/releases/**/meta.json
!/.lti/snapshots/*.json
/.lti/local/
/.lti/locks/
/.lti/transactions/
/.lti/cache/
/.lti/worktrees/
# <<< lti managed ignore rules
