# 环境变量清单（design 2.3 挂载点）。cp .env.example .env 后即可本地起全容器冒烟。
# ⚠️ 下列占位值仅供本地 dev，禁止用于生产；生产值经 systemd EnvironmentFile / compose env_file 注入。

# PostgreSQL 连接串（二进制直跑 / 本地 dev 指向 make db-up 起的库；接现有 PG 时改指过去）
DATABASE_URL=postgres://crm:crm-dev-password@localhost:5432/crm?sslmode=disable

# JWT 签名密钥（HS256）；轮换即吊销全部已发 token
AUTH_TOKEN_SECRET=dev-only-token-secret-change-me

# Access JWT 固定 issuer；签发与校验必须一致
AUTH_TOKEN_ISSUER=photographer-crm

# 邮件 action URL 与 cookie-mutating API Origin 校验的唯一 origin；仅 localhost 开发可用 HTTP
PUBLIC_BASE_URL=http://localhost:8080

# 公开注册默认关闭；email-account-access 完成后仍须 public-auth-hardening/preflight 才可在生产开启
AUTH_PUBLIC_REGISTRATION_ENABLED=false

# 当前 unavailable 为 fail-closed 占位；真实 provider adapter 验证完成后改为对应 driver
AUTH_MAIL_DRIVER=unavailable

# AUTH_MAIL_DRIVER=resend 时必填；API key 只经环境注入，不入库、不入日志
RESEND_API_KEY=

# Resend sender；onboarding sender 仅用于受控非生产 receipt，production 须使用已验证域名
AUTH_MAIL_FROM=Photographer CRM <onboarding@resend.dev>

# 仅真实邮件验收 runner 使用；不得写入报告或日志
AUTH_MAIL_ACCEPTANCE_RECIPIENT=

# 可信反代 CIDR，当前直连部署留空
TRUSTED_PROXY_CIDRS=

# 仅 accountctl bootstrap 运行时临时注入；禁止写真实值到 .env、argv 或日志
ACCOUNTCTL_AUTH_PASSWORD=

# HTTP 监听地址
HTTP_ADDR=:8080

# 客户头像对象存储：首版仅 local。二进制直跑可使用普通目录并关闭 mount attestation；
# production compose 会覆盖为 /var/lib/crm/avatars + require-mount=true。
AVATAR_STORAGE_DRIVER=local
AVATAR_LOCAL_ROOT=./var/avatars
AVATAR_LOCAL_REQUIRE_MOUNT=false

# Telegram Bot API（两项同时为空时禁用；token 只经环境注入）
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# docker compose 的 postgres 服务凭证（与 DATABASE_URL 保持一致）
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm-dev-password
POSTGRES_DB=crm

# 容器轨接现有 PG 时才设：app 容器内生效的连接串（缺省 = 直连 compose 内 postgres 服务）；
# 配合 `docker compose up -d --no-deps --wait app` 只起 app
APP_DATABASE_URL=
