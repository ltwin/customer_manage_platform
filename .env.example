# 环境变量清单（design 2.3 挂载点）。cp .env.example .env 后即可本地起全容器冒烟。
# ⚠️ 下列占位值仅供本地 dev，禁止用于生产；生产值经 systemd EnvironmentFile / compose env_file 注入。

# PostgreSQL 连接串（二进制直跑 / 本地 dev 指向 make db-up 起的库；接现有 PG 时改指过去）
DATABASE_URL=postgres://crm:crm-dev-password@localhost:5432/crm?sslmode=disable

# JWT 签名密钥（HS256）；轮换即吊销全部已发 token
AUTH_TOKEN_SECRET=dev-only-token-secret-change-me

# 首次启动 accounts 为空时创建默认账号的密码（seed 完成后可从环境移除）
SEED_ADMIN_PASSWORD=dev-only-admin-password

# HTTP 监听地址
HTTP_ADDR=:8080

# 客户头像对象存储：首版仅 local。二进制直跑可使用普通目录并关闭 mount attestation；
# production compose 会覆盖为 /var/lib/crm/avatars + require-mount=true。
AVATAR_STORAGE_DRIVER=local
AVATAR_LOCAL_ROOT=./var/avatars
AVATAR_LOCAL_REQUIRE_MOUNT=false

# Telegram Bot API（两项同时为空时禁用；token 只经环境注入）
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# docker compose 的 postgres 服务凭证（与 DATABASE_URL 保持一致）
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm-dev-password
POSTGRES_DB=crm

# 容器轨接现有 PG 时才设：app 容器内生效的连接串（缺省 = 直连 compose 内 postgres 服务）；
# 配合 `docker compose up -d --no-deps --wait app` 只起 app
APP_DATABASE_URL=
