# 环境变量清单（design 2.3 挂载点）。cp .env.example .env 后即可本地起全容器冒烟。
# ⚠️ 下列占位值仅供本地 dev，禁止用于生产；生产值经 systemd EnvironmentFile / compose env_file 注入。

# PostgreSQL 连接串（二进制直跑 / 本地 dev 指向 make db-up 起的库；接现有 PG 时改指过去）
DATABASE_URL=postgres://crm:crm-dev-password@localhost:5432/crm?sslmode=disable

# JWT 签名密钥（HS256）；轮换即吊销全部已发 token
AUTH_TOKEN_SECRET=dev-only-token-secret-change-me

# root secret 的非秘密版本引用；production preflight fingerprint 使用，禁止填写 secret 值
AUTH_TOKEN_SECRET_VERSION=development-v1

# 构建 accountctl 时嵌入的 40 位 Git revision；production 容器构建必须覆盖 development
BUILD_REVISION=development

# Access JWT 固定 issuer；签发与校验必须一致
AUTH_TOKEN_ISSUER=photographer-crm

# 邮件 action URL 与 cookie-mutating API Origin 校验的唯一 origin；仅 localhost 开发可用 HTTP
PUBLIC_BASE_URL=http://localhost:8080

# 公开注册默认关闭；email-account-access 完成后仍须 public-auth-hardening/preflight 才可在生产开启
AUTH_PUBLIC_REGISTRATION_ENABLED=false

# 当前 unavailable 为 fail-closed 占位；真实 provider adapter 验证完成后改为对应 driver
AUTH_MAIL_DRIVER=unavailable

# AUTH_MAIL_DRIVER=resend 时必填；API key 只经环境注入，不入库、不入日志
RESEND_API_KEY=

# Resend sender；onboarding sender 仅用于受控非生产 receipt，production 须使用已验证域名
AUTH_MAIL_FROM=Photographer CRM <onboarding@resend.dev>

# 仅真实邮件验收 runner 使用；不得写入报告或日志
AUTH_MAIL_ACCEPTANCE_RECIPIENT=

# 可信反代 CIDR，当前直连部署留空
TRUSTED_PROXY_CIDRS=

# 仅 accountctl bootstrap 运行时临时注入；禁止写真实值到 .env、argv 或日志
ACCOUNTCTL_AUTH_PASSWORD=

# HTTP 监听地址
HTTP_ADDR=:8080

# 对象存储驱动（统管客户头像 avatars/ 与策划素材 planning/）：local | oss。
# local：二进制直跑可使用普通目录并关闭 mount attestation；
#        production compose 会覆盖为 /var/lib/crm/avatars + require-mount=true。
# oss：共享单 bucket，键前缀天然分区；需要下方 OSS_* 配置，凭证只经环境注入
#      （OSS_ACCESS_KEY_ID/OSS_ACCESS_KEY_SECRET，或 ECS RAM Role 实例角色）。
#      bucket 初始化（版本控制、生命周期、最小权限）见 docs/dev/object-storage.md。
AVATAR_STORAGE_DRIVER=local
AVATAR_LOCAL_ROOT=./var/avatars
AVATAR_LOCAL_REQUIRE_MOUNT=false
# 可选：策划素材本地根目录；缺省沿用 AvatarLocalRoot 同级 planning-media
PLANNING_MEDIA_LOCAL_ROOT=

# 创意画布媒体（FND-05）：local 驱动的分片/正式对象根目录；缺省沿用 AvatarLocalRoot 同级 creative-media。
# oss 驱动共用同一 bucket，新对象只写 creative-v2/{account}/staging|blobs 前缀（需 bucket 开启版本控制）。
CREATIVE_MEDIA_LOCAL_ROOT=
# 视频/音频校验用的 ffprobe；找不到时 media-capabilities 只开放图片，不假装支持音视频
CREATIVE_FFPROBE=ffprobe
# 每账号媒体存储额度（字节，默认 20GiB）
CREATIVE_MEDIA_QUOTA_BYTES=

# 统一 LLM Gateway（FND-06）：模型凭证只经环境变量注入，不入库、不入 git。
# 未配置时目录中的模型保持可见但禁用并给出原因，人工画布与资产库不受影响。
DEEPSEEK_API_KEY=
# 可选：覆盖内置模型目录的 JSON 路径；留空用内置 deepseek-2026-09-11 目录
CREATIVE_LLM_CATALOG=
# 每账号月度费用上限（整数 micros，1_000_000 = 1 USD；默认 20_000_000）
CREATIVE_LLM_MONTHLY_LIMIT_MICROS=
# 每账号月度 token 上限（默认 5_000_000）
CREATIVE_LLM_MONTHLY_TOKEN_LIMIT=

# oss driver 配置（AVATAR_STORAGE_DRIVER=oss 时 OSS_REGION/OSS_BUCKET 必填）
OSS_REGION=
# 可选 endpoint；ECS 同地域建议内网（如 oss-cn-hangzhou-internal.aliyuncs.com）
OSS_ENDPOINT=
# endpoint 是绑定到当前 bucket 的自定义域名 CNAME 时设 true；普通/内网 OSS endpoint 保持 false
OSS_USE_CNAME=false
OSS_BUCKET=
# 仅非 ECS RAM Role 场景填写；真实值只放部署环境/.env，不提交
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Telegram Bot API（两项同时为空时禁用；token 只经环境注入）
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# docker compose 的 postgres 服务凭证（与 DATABASE_URL 保持一致）
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm-dev-password
POSTGRES_DB=crm

# 容器轨接现有 PG 时才设：app 容器内生效的连接串（缺省 = 直连 compose 内 postgres 服务）；
# 配合 `docker compose up -d --no-deps --wait app` 只起 app
APP_DATABASE_URL=

# Explicit pilot account IDs, comma-separated; empty disables new enrollment.
