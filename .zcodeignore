# 凭证红线：.env 永不入 git（CLAUDE.md 硬规则 4）
.env

# python
__pycache__/

node_modules/
frontend/dist/
backend/bin/
# 杂散 go build -o server 产物（构建输出统一进 backend/bin/，见 Makefile）
/backend/server
backend/internal/platform/webui/dist/*
!backend/internal/platform/webui/dist/.gitkeep

# Claude Code 执行 worktree
.claude/
.zcode/
.worktrees/

.DS_Store

var/

# AI Agents
.reasonix/
.workflow/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.egg-info/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
