  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "typescript": "~5.9.0",
    "vite": "^8.1.1"
