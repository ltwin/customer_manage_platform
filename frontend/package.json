    "test:package-price": "node --test --experimental-transform-types scripts/package-price.test.ts",
    "test:api-client": "node --test --experimental-transform-types scripts/api-client.test.ts",
    "test:auth": "node --test --experimental-transform-types scripts/auth.test.ts",
    "test:schedule": "node --test --experimental-transform-types scripts/schedule.test.ts",
    "test:settings": "node --test --experimental-transform-types scripts/settings.test.ts",
    "test:avatar-layout": "node --test scripts/avatar-layout.test.mjs",
    "test:customer-avatar": "node --test --experimental-transform-types scripts/customer-avatar.test.ts",
    "test:telegram-digest": "node --test --experimental-transform-types scripts/telegram-digest.test.ts",
    "test:data-export": "node --test --experimental-transform-types scripts/data-export.test.ts",
    "test:account-center": "node --test --experimental-transform-types scripts/account-center.test.ts",
    "test:v1-hardening": "node --test --experimental-transform-types scripts/v1-hardening.test.ts",
    "test:shoot-planning": "node --test --experimental-transform-types scripts/shoot-planning.test.ts",
    "test:shoot-plan-crm": "node --test --experimental-transform-types scripts/shoot-plan-crm.test.ts",
    "test:planning-media": "node --test --experimental-transform-types scripts/planning-media.test.ts",
    "test:plan-ingestion": "node --test --experimental-transform-types scripts/plan-ingestion.test.ts",
    "test:prototype": "node --test scripts/prototype-contract.test.mjs",
    "preview": "vite preview",
