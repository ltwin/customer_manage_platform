    {
     "frame": 30,
     "value": -10,
     "interp": "linear"
    }
   ],
   "expect": [
    {
     "frame": 0,
     "value": 0
    },
    {
     "frame": 3,
     "value": 3.0
    },
    {
     "frame": 10,
     "value": 10
    },
    {
     "frame": 15,
     "value": 5.0
    },
    {
     "frame": 25,
     "value": -5.0
    },
    {
     "frame": 30,
     "value": -10
    }
   ]
  },
