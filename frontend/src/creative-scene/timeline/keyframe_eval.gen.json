{
 "note": "patterns: 关键帧求值 的共用测试向量；由 Python 参考实现生成，Go 与 TS 求值器都必须逐项通过（数值容差 1e-9）。value 为 null 表示通道不给值，保留基础值。改规则时先改这里。",
 "tolerance": 1e-09,
 "cases": [
  {
   "name": "单个关键帧在所有帧取它的值",
   "kind": "number",
   "keys": [
    {
     "frame": 10,
     "value": 3.5,
     "interp": "linear"
    }
   ],
   "expect": [
    {
     "frame": 0,
     "value": 3.5
    },
    {
     "frame": 10,
     "value": 3.5
    },
    {
     "frame": 50,
     "value": 3.5
    }
   ]
  },
  {
   "name": "首前与尾后取端点值",
   "kind": "number",
   "keys": [
    {
     "frame": 10,
     "value": 1,
     "interp": "linear"
    },
    {
     "frame": 20,
     "value": 3,
     "interp": "linear"
    }
   ],
   "expect": [
    {
     "frame": 0,
     "value": 1
    },
    {
     "frame": 9,
     "value": 1
    },
    {
     "frame": 10,
     "value": 1
    },
    {
     "frame": 20,
     "value": 3
    },
    {
     "frame": 21,
     "value": 3
    },
    {
     "frame": 100,
     "value": 3
    }
   ]
  },
  {
